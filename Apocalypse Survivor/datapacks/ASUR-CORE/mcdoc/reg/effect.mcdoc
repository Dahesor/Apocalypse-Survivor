use::java::util::text::Text
use::java::util::text::TextStyle
use::java::world::item::ItemStack
use ::java::world::component::CustomData
use::reg::root::CommonFields

dispatch minecraft:storage["registry:effect"] to struct {
    entry?: [EffectRegistryEntry],
    new?: NewEffectEntry,
    this?: EffectInstance,
    ztemp?: EffectInstance,
}

struct EffectInstance{
    ...EffectRegistryEntry,
    ...EffectInstanceData,
}

struct EffectInstanceData{
    /// Tick when the effect expires.
    until?: int,
    /// Initial duration of the effect.
    i_duration?: int,
    /// Initial intensity of the effect.
    j_intensity?: int,
    /// If the effect is hidden in actionbar.
    hidden?: boolean,
    /// The same effect with a lower intensity but longer duration.
    child?: EffectInstanceData,
    /// The frame allocated
    frame?: string,
}

struct EffectRegistryEntry {
    ...EffectEntry,
    id?: #[id="as:effect"] string,
    display?: struct{
        Name?: Text,
        Description?: Text,
    }
}

struct NewEffectEntry {
    ...EffectEntry,
    id?: #[id(registry="as:effect",definition=true)] string,
}

struct EffectEntry{
    /// If the effect needs a hook
    hooks?: struct{
        /// Run when the effect is applied
        on_apply?: EffectHook,
        /// Run when the effect is removed
        before_remove?: EffectHook,
        /// Run when the intensity of the effect changes
        intensity_change?: EffectHook,
        /// Run for players that was offline
        to_clean?: EffectHook,
    },
    /// If the effect needs a ticker function
    ticker?: struct{
        every?: ("tick"|"second"|"4_ticks"),
        run?: #[command] string,
    },
    /// Icon of the effect
    icon?: string,
    /// Buff or debuff
    polarity?: (1 | -1 |"other"),
    /// If the status may be purified
    may_purify?: int @ 0..,
    /// The piority being purified
    severity?: int @ 0..,
    ...CommonFields,
}

struct EffectHook{
    run?: #[command] string
}